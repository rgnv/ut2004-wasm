diff --git a/Launch/Src/LaunchEmscripten.cpp b/Launch/Src/LaunchEmscripten.cpp
new file mode 100644
index 0000000..55ac09d
--- /dev/null
+++ b/Launch/Src/LaunchEmscripten.cpp
@@ -0,0 +1,95 @@
+// Headless Node smoke boot: use the console startup path without UCC's editor modules.
+#if defined(__EMSCRIPTEN__)
+#include "Engine.h"
+#include "UnLinker.h"
+#include "FMallocAnsi.h"
+#include "FFileManagerUnix.h"
+#include "FOutputDeviceAnsiError.h"
+#include "FFeedbackContextAnsi.h"
+#include "FConfigCacheIni.h"
+#include <unistd.h>
+
+INT GFilesOpen, GFilesOpened;
+extern "C" { TCHAR GPackage[] = TEXT("Launch"); }
+
+class FWasmLog : public FOutputDevice
+{
+public:
+    void Serialize(const TCHAR* Text, EName Event)
+    {
+        printf("%s: %s\n", FName::SafeString(Event), Text);
+        fflush(stdout);
+    }
+};
+
+int main(int argc, char** argv)
+{
+    UBOOL MountOnly = 0;
+    if (argc == 2 && !strcmp(argv[1], "--mount-only")) MountOnly = 1;
+    else if (argc != 1)
+    {
+        fprintf(stderr, "Usage: node build/ut2004.js [--mount-only]\n");
+        return 2;
+    }
+    setbuf(stdout, NULL);
+    if (chdir("/opt/ut2004/System") != 0)
+    {
+        perror("chdir /opt/ut2004/System");
+        return 1;
+    }
+    // Global engine destructors still use these services after main returns.
+    static FMallocAnsi Malloc;
+    static FFileManagerUnix Files;
+    static FWasmLog Log;
+    static FOutputDeviceAnsiError Error;
+    static FFeedbackContextAnsi Warn;
+    strcpy(GModule, "ut2004-wasm");
+    GIsStarted = 1;
+    GIsClient = 0;
+    GIsServer = 1;
+    GIsEditor = 0;
+    appInit(TEXT("UT2004"), TEXT("-nohomedir -nosound"), &Malloc, &Log, &Error, &Warn, &Files, FConfigCacheIni::Factory, 1);
+    FName(NAME_Init).ClearFlags(RF_Suppress);
+    FName(NAME_DevLoad).ClearFlags(RF_Suppress);
+    debugf(NAME_Init, TEXT("WASM: Core init complete"));
+    void* CoreModule = appGetDllHandle(TEXT("/opt/ut2004/System/Core.so"));
+    if (!CoreModule || !appGetDllExport(CoreModule, TEXT("autoclassUObject")) ||
+        appGetDllExport(CoreModule, TEXT("missing_export")) || appGetDllHandle(TEXT("missing_module.so")))
+        appErrorf(TEXT("WASM static registry self-check failed"));
+    debugf(NAME_Init, TEXT("WASM: static registry self-check passed"));
+    if (MountOnly)
+    {
+        const TCHAR* Packages[] = { TEXT("Core"), TEXT("Engine"), TEXT("IpDrv") };
+        for (INT I = 0; I < 3; ++I)
+        {
+            UObject::BeginLoad();
+            ULinkerLoad* Linker = UObject::GetPackageLinker(NULL, Packages[I], LOAD_NoFail | LOAD_NoVerify, NULL, NULL);
+            if (!Linker) appErrorf(TEXT("WASM: failed to mount %s"), Packages[I]);
+            debugf(NAME_Init, TEXT("WASM: mounted %s version=%d names=%d imports=%d exports=%d (tables only)"),
+                *Linker->Filename, Linker->Ver(), Linker->NameMap.Num(), Linker->ImportMap.Num(), Linker->ExportMap.Num());
+            UObject::EndLoad();
+        }
+    }
+    else
+    {
+        UObject::LoadPackage(NULL, TEXT("Core"), LOAD_NoFail);
+        debugf(NAME_Init, TEXT("WASM: Core package loaded"));
+        UObject::LoadPackage(NULL, TEXT("Engine"), LOAD_NoFail);
+        debugf(NAME_Init, TEXT("WASM: Engine package loaded"));
+        UClass* EngineClass = UObject::StaticLoadClass(UGameEngine::StaticClass(), NULL,
+            TEXT("ini:Engine.Engine.GameEngine"), NULL, LOAD_NoFail, NULL);
+        UEngine* Engine = ConstructObject<UEngine>(EngineClass);
+        Engine->Init();
+        debugf(NAME_Init, TEXT("WASM: engine initialized"));
+        for (INT Frame = 0; Frame < 3 && !GIsRequestingExit; ++Frame) Engine->Tick(1.0f / 60.0f);
+        debugf(NAME_Init, TEXT("WASM: bounded loop complete"));
+    }
+    // This probe must not rewrite the installed game's configuration on exit.
+    for (FConfigCacheIni::TIterator It(*(FConfigCacheIni*)GConfig); It; ++It) It.Value().NoSave = 1;
+    appPreExit();
+    appExit();
+    GIsStarted = 0;
+    printf("WASM: clean exit\n");
+    return 0;
+}
+#endif
diff --git a/Launch/Src/wasm-registry.py b/Launch/Src/wasm-registry.py
new file mode 100644
index 0000000..73c5915
--- /dev/null
+++ b/Launch/Src/wasm-registry.py
@@ -0,0 +1,33 @@
+"""Generate static DLL exports from the actual linked objects, not a hand-kept list."""
+import pathlib
+import re
+import subprocess
+import sys
+
+out = ['#if defined(__EMSCRIPTEN__)', '#include "Core.h"',
+       'struct FWasmExport { const char* Name; void* Address; };']
+modules = []
+for module in ("Core", "Engine", "IpDrv"):
+    objects = sorted(pathlib.Path(sys.argv[1], module.lower()).glob("*.o"))
+    assert objects, module
+    symbols = subprocess.check_output(
+        ["/emsdk/upstream/bin/llvm-nm", "--defined-only", "--format=posix", *map(str, objects)],
+        text=True)
+    names = sorted(set(re.findall(r"^(autoclass\w+|int\w+exec\w+) [BD] ", symbols, re.M)))
+    assert names, module
+    for name in names:
+        kind = "UClass*" if name.startswith("autoclass") else "Native"
+        out.append('extern "C" %s %s;' % (kind, name))
+    out.append('static FWasmExport Exports%s[] = {' % module)
+    out.extend('{"%s", &%s},' % (name, name) for name in names)
+    out.append('{NULL, NULL}};')
+    modules.append(module)
+out += ['void* appWasmModule(const TCHAR* Name) {']
+for module in modules:
+    out.append('if (!appStricmp(Name, TEXT("%s"))) return Exports%s;' % (module, module))
+out += ['return NULL; }',
+        'void* appWasmExport(void* Handle, const TCHAR* Name) {',
+        'for (FWasmExport* E = (FWasmExport*)Handle; E && E->Name; ++E)',
+        'if (!appStrcmp(Name, E->Name)) return E->Address;',
+        'return NULL; }', '#endif']
+pathlib.Path(sys.argv[2]).write_text('\n'.join(out) + '\n')
