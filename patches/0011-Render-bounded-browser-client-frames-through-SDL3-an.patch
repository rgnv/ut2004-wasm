+    GConfig->SetString(TEXT("Engine.Engine"), TEXT("RenderDevice"), TEXT("OpenGLDrv.OpenGLRenderDevice"));
+    GConfig->SetBool(TEXT("SDLDrv.SDLClient"), TEXT("StartupFullscreen"), 0);
+    GConfig->SetInt(TEXT("SDLDrv.SDLClient"), TEXT("WindowedViewportX"), 640);
