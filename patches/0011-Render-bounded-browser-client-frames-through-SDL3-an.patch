     FName(NAME_Init).ClearFlags(RF_Suppress);
     FName(NAME_DevLoad).ClearFlags(RF_Suppress);
     debugf(NAME_Init, TEXT("WASM: Core init complete"));
@@ -87,7 +104,15 @@ int main(int argc, char** argv)
         UEngine* Engine = ConstructObject<UEngine>(EngineClass);
         Engine->Init();
         debugf(NAME_Init, TEXT("WASM: engine initialized"));
+#if defined(UT2004_WEB_CLIENT)
+        GIsRunning = 1;
+        INT Frame = 0;
+        for (; Frame < 6 && !GIsRequestingExit; ++Frame) Engine->Tick(1.0f / 60.0f);
+        GIsRunning = 0;
+        debugf(NAME_Init, TEXT("WASM: browser ticks=%i"), Frame);
+#else
         for (INT Frame = 0; Frame < 3 && !GIsRequestingExit; ++Frame) Engine->Tick(1.0f / 60.0f);
+#endif
         if (emscripten_run_script_int("typeof window !== 'undefined' || typeof importScripts === 'function'"))
             debugf(NAME_Init, TEXT("WASM: browser bounded loop complete"));
         else
