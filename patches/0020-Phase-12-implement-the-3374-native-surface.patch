+void AGameInfo::execStripColor( FFrame& Stack, RESULT_DECL )
+{
+	guardSlow(AGameInfo::execStripColor);
+	P_GET_STR(S);
+	P_FINISH;
+	FString Out;
+	const TCHAR* Ptr = *S;
+	while( *Ptr )
+	{
+		if( *Ptr == 0x1B )
+		{
+			if( Ptr[1] && Ptr[2] && Ptr[3] )
+			{
+				Ptr += 4;
+				continue;
+			}
+			break;
+		}
+		TCHAR Ch[2] = { *Ptr++, 0 };
+		Out += Ch;
+	}
+	*(FString*)Result = Out;
+	unguardexecSlow;
+}
+
+static inline INT HexVal( TCHAR C )
+{
+	if( C >= '0' && C <= '9' ) return C - '0';
+	if( C >= 'a' && C <= 'f' ) return C - 'a' + 10;
+	if( C >= 'A' && C <= 'F' ) return C - 'A' + 10;
+	return -1;
+}
+
+void AGameInfo::execFromINIFormat( FFrame& Stack, RESULT_DECL )
+{
+	guardSlow(AGameInfo::execFromINIFormat);
+	P_GET_STR(S);
+	P_FINISH;
+	FString Out;
+	const TCHAR* Ptr = *S;
+	while( *Ptr )
+	{
+		if( Ptr[0] == '(' && Ptr[1] == '#' &&
+			HexVal(Ptr[2]) >= 0 && HexVal(Ptr[3]) >= 0 &&
+			HexVal(Ptr[4]) >= 0 && HexVal(Ptr[5]) >= 0 &&
+			HexVal(Ptr[6]) >= 0 && HexVal(Ptr[7]) >= 0 &&
+			Ptr[8] == ')' )
+		{
+			TCHAR Code[5];
+			Code[0] = 0x1B;
+			Code[1] = Max<INT>( (HexVal(Ptr[2]) << 4) | HexVal(Ptr[3]), 1 );
+			Code[2] = Max<INT>( (HexVal(Ptr[4]) << 4) | HexVal(Ptr[5]), 1 );
+			Code[3] = Max<INT>( (HexVal(Ptr[6]) << 4) | HexVal(Ptr[7]), 1 );
+			Code[4] = 0;
+			Out += Code;
+			Ptr += 9;
+			continue;
+		}
+		TCHAR Ch[2] = { *Ptr++, 0 };
+		Out += Ch;
+	}
+	*(FString*)Result = Out;
+	unguardexecSlow;
+}
+
+void AGameInfo::execGetCurrentTickRate( FFrame& Stack, RESULT_DECL )
+{
+	guardSlow(AGameInfo::execGetCurrentTickRate);
+	P_FINISH;
+	*(FLOAT*)Result = (XLevel && XLevel->Engine) ? XLevel->Engine->CurrentTickRate : 0.f;
+	unguardexecSlow;
+}
+
+void AGameInfo::execGetConfiguredTickRate( FFrame& Stack, RESULT_DECL )
+{
+	guardSlow(AGameInfo::execGetConfiguredTickRate);
+	P_FINISH;
+	if( XLevel && XLevel->NetDriver )
+		*(INT*)Result = XLevel->NetDriver->NetServerMaxTickRate;
+	else if( XLevel && XLevel->Engine )
+		*(INT*)Result = appRound( XLevel->Engine->GetMaxTickRate() );
+	else
+		*(INT*)Result = 0;
+	unguardexecSlow;
+}
