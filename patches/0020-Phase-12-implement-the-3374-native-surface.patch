+void UObjectPool::execAllocateObject( FFrame& Stack, RESULT_DECL )
+{
+	guardSlow(UObjectPool::execAllocateObject);
+	P_GET_OBJECT(UClass, ObjectClass);
+	P_FINISH;
+	if( !ObjectClass )
+	{
+		Stack.Log( NAME_ScriptWarning, TEXT("AllocateObject: None ObjectClass") );
+		*(UObject**)Result = NULL;
+		return;
+	}
+	for( INT i = Objects.Num() - 1; i >= 0; i-- )
+	{
+		UObject* Obj = Objects(i);
+		if( !Obj )
+		{
+			Objects.Remove( i );
+			continue;
+		}
+		if( Obj->GetClass() == ObjectClass )
+		{
+			*(UObject**)Result = Obj;
+			Objects.Remove( i );
+			return;
+		}
+	}
+	*(UObject**)Result = StaticConstructObject( ObjectClass, GetOuter(), NAME_None, RF_Transient );
+	unguardexecSlow;
+}
+
+void UObjectPool::execFreeObject( FFrame& Stack, RESULT_DECL )
+{
+	guardSlow(UObjectPool::execFreeObject);
+	P_GET_OBJECT(UObject, Obj);
+	P_FINISH;
+	if( Obj )
+		Objects.AddItem( Obj );
+	else
+		Stack.Log( NAME_ScriptWarning, TEXT("FreeObject: None Obj") );
+	unguardexecSlow;
+}
+
+void UObjectPool::execShrink( FFrame& Stack, RESULT_DECL )
