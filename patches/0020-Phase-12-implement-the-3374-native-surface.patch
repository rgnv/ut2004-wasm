+static void CallDriverRadiusDamage( AVehicle* V, FLOAT DamageAmount, FLOAT DamageRadius, AController* InstigatorController, UClass* DamageType, FLOAT Momentum, FVector HitLocation )
+{
+	struct FDriverRadiusDamageParms
+	{
+		FLOAT DamageAmount;
+		FLOAT DamageRadius;
+		AController* EventInstigator;
+		UClass* DamageType;
+		FLOAT Momentum;
+		FVector HitLocation;
+	} Parms;
+	Parms.DamageAmount = DamageAmount;
+	Parms.DamageRadius = DamageRadius;
+	Parms.EventInstigator = InstigatorController;
+	Parms.DamageType = DamageType;
+	Parms.Momentum = Momentum;
+	Parms.HitLocation = HitLocation;
+	UFunction* Fn = V->FindFunction( FName(TEXT("DriverRadiusDamage"), FNAME_Find) );
+	if( Fn )
+		V->ProcessEvent( Fn, &Parms );
+}
+
+static void CallSetDelayedDamageInstigatorController( AActor* Victim, AController* C )
+{
+	struct FParms { AController* C; } Parms = { C };
+	UFunction* Fn = Victim->FindFunction( FName(TEXT("SetDelayedDamageInstigatorController"), FNAME_Find) );
+	if( Fn )
+		Victim->ProcessEvent( Fn, &Parms );
+}
