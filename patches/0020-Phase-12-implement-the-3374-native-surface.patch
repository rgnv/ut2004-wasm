 IMPLEMENT_FUNCTION( UObject, INDEX_NONE, execIsSoaking );
 // --- gam
 
+static UBOOL GIsUTracing = 0;
+
+void UObject::execRandRange( FFrame& Stack, RESULT_DECL )
+{
+	guardSlow(UObject::execRandRange);
+	P_GET_FLOAT(Min);
+	P_GET_FLOAT(Max);
+	P_FINISH;
+	*(FLOAT*)Result = Min + (Max - Min) * appFrand();
+	unguardexecSlow;
+}
+IMPLEMENT_FUNCTION( UObject, INDEX_NONE, execRandRange );
+
+void UObject::execFloatToFormattedString( FFrame& Stack, RESULT_DECL )
+{
+	guardSlow(UObject::execFloatToFormattedString);
+	P_GET_FLOAT(MyFloat);
+	P_GET_INT_OPTX(Decimals, 2);
+	P_FINISH;
+	FString Format = FString::Printf( TEXT("%%.%df"), Decimals );
+	*(FString*)Result = FString::Printf( *Format, (DOUBLE)MyFloat );
+	unguardexecSlow;
+}
+IMPLEMENT_FUNCTION( UObject, INDEX_NONE, execFloatToFormattedString );
+
+void UObject::execIsUTracing( FFrame& Stack, RESULT_DECL )
+{
+	guardSlow(UObject::execIsUTracing);
+	P_FINISH;
+	*(UBOOL*)Result = GIsUTracing;
+	unguardexecSlow;
+}
+IMPLEMENT_FUNCTION( UObject, INDEX_NONE, execIsUTracing );
+
+void UObject::execSetUTracing( FFrame& Stack, RESULT_DECL )
+{
+	guardSlow(UObject::execSetUTracing);
+	P_GET_UBOOL(bNewUTracing);
+	P_FINISH;
+	GIsUTracing = bNewUTracing;
+	*(UBOOL*)Result = 0;
+	unguardexecSlow;
+}
+IMPLEMENT_FUNCTION( UObject, INDEX_NONE, execSetUTracing );
+
+void UObject::execGetModName( FFrame& Stack, RESULT_DECL )
+{
+	guardSlow(UObject::execGetModName);
+	P_FINISH;
+	*(FString*)Result = GModName;
+	unguardexecSlow;
+}
+IMPLEMENT_FUNCTION( UObject, INDEX_NONE, execGetModName );
+
+void UObject::execAllPackageFiles( FFrame& Stack, RESULT_DECL )
+{
+	guardSlow(UObject::execAllPackageFiles);
+	P_GET_STR_REF(FileName);
+	P_GET_STR_OPTX(FileExt, TEXT(""));
+	P_GET_STR_OPTX(Prefix, TEXT(""));
+	P_FINISH;
+
+	TArray<FString> PackageNames;
+	if( GSys )
+	{
+		for( INT i = 0; i < GSys->Paths.Num(); i++ )
+		{
+			FString Path = GSys->Paths(i);
+			INT Star = Path.InStr( TEXT("*") );
+			if( Star == INDEX_NONE )
+				continue;
+			FString Ext = Path.Mid( Star + 1 );
+			if( Ext.Left(1) == TEXT(".") )
+				Ext = Ext.Mid( 1 );
+			if( FileExt.Len() && appStricmp( *Ext, *FileExt ) != 0 )
+				continue;
+			TArray<FString> Files = GFileManager->FindFiles( *Path, 1, 0 );
+			for( INT j = 0; j < Files.Num(); j++ )
+			{
+				FString Base = Files(j);
+				INT Dot = Base.InStr( TEXT("."), 1 );
+				if( Dot != INDEX_NONE )
+					Base = Base.Left( Dot );
+				if( Prefix.Len() && appStrnicmp( *Base, *Prefix, Prefix.Len() ) != 0 )
+					continue;
+				UBOOL Exists = 0;
+				for( INT k = 0; k < PackageNames.Num(); k++ )
+				{
+					if( appStricmp( *PackageNames(k), *Base ) == 0 )
+					{
+						Exists = 1;
+						break;
+					}
+				}
+				if( !Exists )
+					new(PackageNames) FString( Base );
+			}
+		}
+	}
+
+	INT Index = 0;
+	PRE_ITERATOR;
+		if( Index < PackageNames.Num() )
+		{
+			*FileName = PackageNames(Index++);
+		}
+		else
+		{
+			*FileName = TEXT("");
+			Stack.Code = &Stack.Node->Script(wEndOffset + 1);
+			break;
+		}
+	POST_ITERATOR;
+	unguardexecSlow;
+}
+IMPLEMENT_FUNCTION( UObject, 198, execAllPackageFiles );
+
