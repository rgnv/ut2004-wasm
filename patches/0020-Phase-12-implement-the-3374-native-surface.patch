+void AActor::execHurtRadius( FFrame& Stack, RESULT_DECL )
+{
+	guardSlow(AActor::execHurtRadius);
+	P_GET_FLOAT(DamageAmount);
+	P_GET_FLOAT(DamageRadius);
+	P_GET_OBJECT(UClass, DamageType);
+	P_GET_FLOAT(Momentum);
+	P_GET_VECTOR(HitLocation);
+	P_FINISH;
+
+	if( bHurtEntry || !XLevel || !XLevel->Hash )
+		return;
+	bHurtEntry = 1;
+	FMemMark Mark(GMem);
+	FCheckResult* Link = XLevel->Hash->ActorRadiusCheck( GMem, HitLocation, DamageRadius, 0 );
+	for( ; Link; Link = Link->GetNext() )
+	{
+		AActor* Victim = Link->Actor;
+		if( !Victim || Victim == this || Victim->IsPendingKill() || Victim->Role != ROLE_Authority || Victim->IsA(AFluidSurfaceInfo::StaticClass()) )
+			continue;
+		UFunction* TakeDamageFn = Victim->FindFunction( ENGINE_TakeDamage );
+		if( !TakeDamageFn || !(TakeDamageFn->FunctionFlags & FUNC_Defined) )
+			continue;
+		FCheckResult Hit(1.f);
+		XLevel->SingleLineCheck( Hit, this, Victim->Location, HitLocation, TRACE_World );
+		if( Hit.Actor && Hit.Actor != Victim )
+			continue;
+		FVector Dir = Victim->Location - HitLocation;
+		FLOAT Dist = Max<FLOAT>( 1.f, Dir.Size() );
+		Dir = Dir / Dist;
+		FLOAT DamageScale = 1.f - Max<FLOAT>( 0.f, (Dist - Victim->CollisionRadius) / DamageRadius );
+		Victim->eventTakeDamage(
+			appFloor( DamageScale * DamageAmount ),
+			Instigator,
+			Victim->Location - 0.5f * (Victim->CollisionHeight + Victim->CollisionRadius) * Dir,
+			DamageScale * Momentum * Dir,
+			DamageType
+		);
+		AVehicle* V = Cast<AVehicle>(Victim);
+		if( Instigator && V && !V->IsPendingKill() && V->Health > 0 )
+			CallDriverRadiusDamage( V, DamageAmount, DamageRadius, Instigator->Controller, DamageType, Momentum, HitLocation );
+	}
+	Mark.Pop();
+	bHurtEntry = 0;
+	unguardexecSlow;
+}
+
+void AProjectile::execHurtRadius( FFrame& Stack, RESULT_DECL )
+{
+	guardSlow(AProjectile::execHurtRadius);
+	P_GET_FLOAT(DamageAmount);
+	P_GET_FLOAT(DamageRadius);
+	P_GET_OBJECT(UClass, DamageType);
+	P_GET_FLOAT(Momentum);
+	P_GET_VECTOR(HitLocation);
+	P_FINISH;
+
+	if( bHurtEntry || !XLevel || !XLevel->Hash )
+		return;
+	bHurtEntry = 1;
+	FMemMark Mark(GMem);
+	FCheckResult* Link = XLevel->Hash->ActorRadiusCheck( GMem, HitLocation, DamageRadius, 0 );
+	for( ; Link; Link = Link->GetNext() )
+	{
+		AActor* Victim = Link->Actor;
+		if( !Victim || Victim == this || Victim == HurtWall || Victim->IsPendingKill() || Victim->Role != ROLE_Authority || Victim->IsA(AFluidSurfaceInfo::StaticClass()) )
+		{
+			if( Victim == LastTouched )
+				LastTouched = NULL;
+			continue;
+		}
+		UFunction* TakeDamageFn = Victim->FindFunction( ENGINE_TakeDamage );
+		if( !TakeDamageFn || !(TakeDamageFn->FunctionFlags & FUNC_Defined) )
+			continue;
+		if( Victim != LastTouched )
+		{
+			FCheckResult Hit(1.f);
+			XLevel->SingleLineCheck( Hit, this, Victim->Location, HitLocation, TRACE_World );
+			if( Hit.Actor && Hit.Actor != Victim )
+				continue;
+		}
+		FVector Dir = Victim->Location - HitLocation;
+		FLOAT Dist = Max<FLOAT>( 1.f, Dir.Size() );
+		Dir = Dir / Dist;
+		FLOAT DamageScale = 1.f - Max<FLOAT>( 0.f, (Dist - Victim->CollisionRadius) / DamageRadius );
+		if( !Instigator || !Instigator->Controller )
+			CallSetDelayedDamageInstigatorController( Victim, InstigatorController );
+		if( Victim == LastTouched )
+			LastTouched = NULL;
+		Victim->eventTakeDamage(
+			appFloor( DamageScale * DamageAmount ),
+			Instigator,
+			Victim->Location - 0.5f * (Victim->CollisionHeight + Victim->CollisionRadius) * Dir,
+			DamageScale * Momentum * Dir,
+			DamageType
+		);
+		AVehicle* V = Cast<AVehicle>(Victim);
+		if( Instigator && V && !V->IsPendingKill() && V->Health > 0 )
+			CallDriverRadiusDamage( V, DamageAmount, DamageRadius, InstigatorController, DamageType, Momentum, HitLocation );
+	}
+	if( LastTouched && LastTouched != this && !LastTouched->IsPendingKill() && LastTouched->Role == ROLE_Authority && !LastTouched->IsA(AFluidSurfaceInfo::StaticClass()) )
+	{
+		AActor* Victim = LastTouched;
+		LastTouched = NULL;
+		FVector Dir = Victim->Location - HitLocation;
+		FLOAT Dist = Max<FLOAT>( 1.f, Dir.Size() );
+		Dir = Dir / Dist;
+		FLOAT DamageScale = Max<FLOAT>( Victim->CollisionRadius / (Victim->CollisionRadius + Victim->CollisionHeight), 1.f - Max<FLOAT>( 0.f, (Dist - Victim->CollisionRadius) / DamageRadius ) );
+		if( !Instigator || !Instigator->Controller )
+			CallSetDelayedDamageInstigatorController( Victim, InstigatorController );
+		Victim->eventTakeDamage(
+			(INT)( DamageScale * DamageAmount ),
+			Instigator,
+			Victim->Location - 0.5f * (Victim->CollisionHeight + Victim->CollisionRadius) * Dir,
+			DamageScale * Momentum * Dir,
+			DamageType
+		);
+		AVehicle* V = Cast<AVehicle>(Victim);
+		if( Instigator && V && !V->IsPendingKill() && V->Health > 0 )
+			CallDriverRadiusDamage( V, DamageAmount, DamageRadius, InstigatorController, DamageType, Momentum, HitLocation );
+	}
+	Mark.Pop();
+	bHurtEntry = 0;
+	unguardexecSlow;
+}
