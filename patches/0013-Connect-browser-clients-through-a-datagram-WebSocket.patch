diff --git a/IpDrv/Src/TcpNetDriver.cpp b/IpDrv/Src/TcpNetDriver.cpp
index ca76e81..203f71f 100644
--- a/IpDrv/Src/TcpNetDriver.cpp
+++ b/IpDrv/Src/TcpNetDriver.cpp
@@ -12,6 +12,59 @@ Notes:
 
 #include "UnIpDrv.h"
 #include "UnTcpNetDriver.h"
+#if defined(__EMSCRIPTEN__) && defined(UT2004_WEB_CLIENT)
+#include <emscripten.h>
+// Own the WebSocket per net driver; SOCKFS adds framing our UDP relay does not use.
+EM_JS(int, WasmNetOpen, (), {
+    try {
+        const ws = new WebSocket(Module.relayURL || 'wss://games.rgnv.dev/ut2004/connect2');
+        ws.binaryType = 'arraybuffer';
+        const sessions = Module.netSessions || (Module.netSessions = {});
+        const id = Module.netNextId = (Module.netNextId || 0) + 1;
+        const s = sessions[id] = {ws, incoming: [], outgoing: [], bytes: 0, failed: false, sent: 0, received: 0};
+        ws.onopen = () => {
+            console.log('WASM WS open ' + ws.url);
+            for (const data of s.outgoing) ws.send(data);
+            s.outgoing = [];
+        };
+        ws.onmessage = event => {
+            if (!(event.data instanceof ArrayBuffer) || event.data.byteLength < 1 || event.data.byteLength > 576 || s.bytes + event.data.byteLength > 1048576) {
+                s.failed = true; ws.close(1009); return;
+            }
+            s.incoming.push(new Uint8Array(event.data));
+            s.bytes += event.data.byteLength;
+            ++s.received;
+        };
+        ws.onerror = () => { s.failed = true; console.log('WASM WS error'); };
+        ws.onclose = event => { s.failed = true; console.log('WASM WS closed ' + event.code); };
+        return id;
+    } catch (error) { console.log('WASM WS create failed: ' + error); return 0; }
+});
+EM_JS(int, WasmNetSend, (int id, const void* data, int count), {
+    const s = Module.netSessions[id];
+    if (!s || s.failed || count < 0 || count > 576) return 0;
+    const packet = HEAPU8.slice(data, data + count);
+    if (s.ws.readyState === 0 && s.outgoing.length < 256) s.outgoing.push(packet);
+    else if (s.ws.readyState === 1 && s.ws.bufferedAmount < 1048576) s.ws.send(packet);
+    else { s.failed = true; return 0; }
+    ++s.sent;
+    return 1;
+});
+EM_JS(int, WasmNetReceive, (int id, void* data), {
+    const s = Module.netSessions[id];
+    if (!s || s.failed) return -1;
+    const packet = s.incoming.shift();
+    if (!packet) return 0;
+    s.bytes -= packet.length;
+    HEAPU8.set(packet, data);
+    return packet.length;
+});
+EM_JS(void, WasmNetClose, (int id), {
+    const s = Module.netSessions && Module.netSessions[id];
+    if (s) { s.ws.onmessage = null; s.ws.close(); delete Module.netSessions[id]; }
+});
+#endif
+
 
