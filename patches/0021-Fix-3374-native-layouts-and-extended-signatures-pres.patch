diff --git a/Core/Src/UnClass.cpp b/Core/Src/UnClass.cpp
index 11c2072..d3d5562 100644
--- a/Core/Src/UnClass.cpp
+++ b/Core/Src/UnClass.cpp
@@ -8,6 +8,57 @@
 
 #include "CorePrivate.h"
 
+
+static FNativeStructLayout* GNativeStructLayouts = NULL;
+
+void RegisterNativeStructLayout( FNativeStructLayout* Layout )
+{
+	check(Layout && Layout->PackageName && Layout->StructName && Layout->NativeSize>0);
+	check(Layout->PropertyCount>=0 && (!Layout->PropertyCount || Layout->Properties));
+	for( FNativeStructLayout* Existing=GNativeStructLayouts; Existing; Existing=Existing->Next )
+	{
+		if( !appStricmp(Existing->PackageName,Layout->PackageName)
+		&&	((!Existing->OuterName && !Layout->OuterName)
+			|| (Existing->OuterName && Layout->OuterName && !appStricmp(Existing->OuterName,Layout->OuterName)))
+		&&	!appStricmp(Existing->StructName,Layout->StructName) )
+		{
+			check(Existing->NativeSize==Layout->NativeSize);
+			return;
+		}
+	}
+	Layout->Next = GNativeStructLayouts;
+	GNativeStructLayouts = Layout;
+}
+
+static const FNativeStructLayout* FindNativeStructLayout( const UStruct* Struct )
+{
+	UObject* Outer = Struct->GetOuter();
+	UObject* Parent = Outer ? Outer->GetOuter() : NULL;
+	UObject* Package = Parent ? Parent : Outer;
+	if( !Outer || !Package )
+		return NULL;
+	for( FNativeStructLayout* Layout=GNativeStructLayouts; Layout; Layout=Layout->Next )
+	{
+		if( !appStricmp(Struct->GetName(),Layout->StructName)
+		&&	((!Layout->OuterName && !Parent)
+			|| (Layout->OuterName && Parent && !appStricmp(Outer->GetName(),Layout->OuterName)))
+		&&	!appStricmp(Package->GetName(),Layout->PackageName) )
+			return Layout;
+	}
+	return NULL;
+}
+
+static const FNativePropertyLayout* GetNativePropertyLayout( const FNativeStructLayout* Layout, const TCHAR* PropertyName )
+{
+	if( Layout )
+	{
+		for( INT i=0; i<Layout->PropertyCount; i++ )
+			if( !appStricmp(Layout->Properties[i].PropertyName,PropertyName) )
+				return &Layout->Properties[i];
+	}
+	return NULL;
+}
