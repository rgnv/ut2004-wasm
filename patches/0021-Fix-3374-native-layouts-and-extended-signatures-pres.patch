+// Persistent geometry uses the same tessellation as FLineBatcher and the existing staying-line buffer.
+static void AddStayingDebugCircle( FVector Base, FVector X, FVector Y, FColor Color, FLOAT Radius, INT NumSides )
+{
+	FLOAT AngleDelta = 2.0f * PI / NumSides;
+	FVector LastVertex = Base + X * Radius;
+	for( INT SideIndex=0; SideIndex<NumSides; SideIndex++ )
+	{
+		FVector Vertex = Base + (X * appCos(AngleDelta * (SideIndex + 1)) + Y * appSin(AngleDelta * (SideIndex + 1))) * Radius;
+		GTempLineBatcher->AddStayingLine(LastVertex,Vertex,Color);
+		LastVertex = Vertex;
+	}
+}
+
+static void AddStayingDebugSphere( FVector Base, FColor Color, FLOAT Radius, INT NumDivisions )
+{
+	FLOAT AngleDelta = 2.0f * PI / NumDivisions;
+	FLOAT SegmentDist = 2.0f * Radius / NumDivisions;
+	for( INT SideIndex=-NumDivisions/2; SideIndex<NumDivisions/2; SideIndex++ )
+		AddStayingDebugCircle(Base-FVector(0,0,SideIndex*SegmentDist),FVector(1,0,0),FVector(0,1,0),Color,appSqrt(Radius*Radius-SideIndex*SegmentDist*SideIndex*SegmentDist),NumDivisions);
+	for( INT SideIndex=0; SideIndex<NumDivisions; SideIndex++ )
+		AddStayingDebugCircle(Base,FVector(0,0,1),FVector(1,0,0)*appCos(AngleDelta*SideIndex)+FVector(0,1,0)*appSin(AngleDelta*SideIndex),Color,Radius,NumDivisions);
+}
+
+// Match FLineBatcher::DrawBox's 12 wireframe edges, retaining them in the persistent line buffer.
+static void AddStayingDebugBox( FBox Box, FColor Color )
+{
+	FVector B[2], P, Q;
+	B[0] = Box.Min;
+	B[1] = Box.Max;
+	for( INT i=0; i<2; i++ )
+		for( INT j=0; j<2; j++ )
+		{
+			P.X = B[i].X; Q.X = B[i].X;
+			P.Y = B[j].Y; Q.Y = B[j].Y;
+			P.Z = B[0].Z; Q.Z = B[1].Z;
+			GTempLineBatcher->AddStayingLine(P,Q,Color);
+
+			P.Y = B[i].Y; Q.Y = B[i].Y;
+			P.Z = B[j].Z; Q.Z = B[j].Z;
+			P.X = B[0].X; Q.X = B[1].X;
+			GTempLineBatcher->AddStayingLine(P,Q,Color);
+
+			P.Z = B[i].Z; Q.Z = B[i].Z;
+			P.X = B[j].X; Q.X = B[j].X;
+			P.Y = B[0].Y; Q.Y = B[1].Y;
+			GTempLineBatcher->AddStayingLine(P,Q,Color);
+		}
+}
