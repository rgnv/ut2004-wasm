+// Compiler-authored storage layout for reflected native structs and classes.
+struct FNativePropertyLayout
+{
+	const TCHAR* PropertyName;
+	INT Offset;
+	INT NativeSize;
+	INT NativeArrayDim;
+	DWORD BitMask;
+	UBOOL bOverrideBitMask;
+};
+struct FNativeStructLayout
+{
+	const TCHAR* PackageName;
+	const TCHAR* OuterName;
+	const TCHAR* StructName;
+	INT NativeSize;
+	const FNativePropertyLayout* Properties;
+	INT PropertyCount;
+	FNativeStructLayout* Next;
+};
+CORE_API void RegisterNativeStructLayout( FNativeStructLayout* Layout );
+
