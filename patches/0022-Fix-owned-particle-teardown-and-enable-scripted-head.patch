+    const char* TicksEnv = getenv("UT2004_HEADLESS_TICKS");
+    const INT Bots = BotsEnv && BotsEnv[0] ? Clamp(atoi(BotsEnv), 0, 32) : 2;
+    char NodeCommandLine[1024];
+    // Use game options that exercise normal match startup and player filling.
+    snprintf(NodeCommandLine, sizeof(NodeCommandLine), "%s?NumBots=%d?MinPlayers=%d?QuickStart=1 -nohomedir -nosound",
+        MapEnv && MapEnv[0] ? MapEnv : "DM-Rankin", Bots, Bots);
+    const INT HeadlessTicks = TicksEnv && TicksEnv[0] ? Clamp(atoi(TicksEnv), 1, 10000) : 120;
+    const TCHAR* CommandLine = NodeCommandLine;
 #endif
     appInit(TEXT("UT2004"), CommandLine, &Malloc, &Log, &Error, &Warn, &Files, FConfigCacheIni::Factory, 1);
     RegisterNamesOnslaught();
     RegisterNamesXInterface();
-#if defined(UT2004_WEB_CLIENT)
     GIsScriptable = 1;
+#if defined(UT2004_WEB_CLIENT)
     GConfig->SetString(TEXT("Engine.Engine"), TEXT("ViewportManager"), TEXT("SDLDrv.SDLClient"));
     GConfig->SetString(TEXT("Engine.Engine"), TEXT("RenderDevice"), TEXT("OpenGLDrv.OpenGLRenderDevice"));
     GConfig->SetBool(TEXT("SDLDrv.SDLClient"), TEXT("StartupFullscreen"), 0);
@@ -235,7 +244,31 @@ int main(int argc, char** argv)
         GIsRunning = 0;
         debugf(NAME_Init, TEXT("WASM: browser ticks=%i"), Frame);
 #else
-        for (INT Frame = 0; Frame < 3 && !GIsRequestingExit; ++Frame) Engine->Tick(1.0f / 60.0f);
+        UGameEngine* GameEngine = (UGameEngine*)Engine;
+        INT HeadlessFrame = 0;
+        for (; HeadlessFrame < HeadlessTicks && !GIsRequestingExit; ++HeadlessFrame)
+            Engine->Tick(1.0f / 60.0f);
+        ULevel* LoadedLevel = GameEngine->GLevel;
+        INT Controllers = 0, BotPawns = 0, ControlledNonVehiclePawns = 0;
+        if (LoadedLevel)
+            for (INT I = 0; I < LoadedLevel->Actors.Num(); ++I)
+            {
+                AActor* Actor = LoadedLevel->Actors(I);
+                if (Actor && Actor->IsA(AController::StaticClass()))
+                {
+                    AController* Controller = (AController*)Actor;
+                    ++Controllers;
+                    if (Controller->Pawn && !Controller->Pawn->IsA(AVehicle::StaticClass()))
+                        ++ControlledNonVehiclePawns;
+                    if (Controller->PlayerReplicationInfo && Controller->PlayerReplicationInfo->bBot && Controller->Pawn)
+                        ++BotPawns;
+                }
+            }
+        AGameInfo* LoadedGame = LoadedLevel ? LoadedLevel->GetLevelInfo()->Game : NULL;
+        debugf(NAME_Log, TEXT("WASM_HEADLESS_PROOF: map=%s game=%s ticks=%i controllers=%i controlledNonVehiclePawns=%i botPawns=%i requestedBots=%d"),
+            LoadedLevel && LoadedLevel->GetOuter() ? LoadedLevel->GetOuter()->GetName() : TEXT("<none>"),
+            LoadedGame ? LoadedGame->GetClass()->GetPathName() : TEXT("<none>"),
+            HeadlessFrame, Controllers, ControlledNonVehiclePawns, BotPawns, Bots);
 #endif
 #if defined(UT2004_WEB_CLIENT)
         if (Interactive)
