     const UBOOL Splash = EM_ASM_INT({ return Module.splash ? 1 : 0; });
     const UBOOL NoSound = EM_ASM_INT({ return Module.noSound ? 1 : 0; });
     char Map[256];
-    EM_ASM({ stringToUTF8(Module.map || 'DM-Rankin', $0, $1); }, Map, sizeof(Map));
+    EM_ASM({ stringToUTF8((Module.map || 'DM-Rankin') + (Module.gameClass ? '?game=' + Module.gameClass : ''), $0, $1); }, Map, sizeof(Map));
     const UBOOL LocalMap = EM_ASM_INT({ return Module.localMap ? 1 : 0; });
     char BrowserCommandLine[320];
     snprintf(BrowserCommandLine, sizeof(BrowserCommandLine), "%s?NumBots=%i -nohomedir%s",
@@ -85,13 +85,22 @@ int main(int argc, char** argv)
     const TCHAR* CommandLine = Interactive && !Splash ? BrowserCommandLine
         : (Interactive && !NoSound ? TEXT("-nohomedir") : TEXT("-nohomedir -nosound"));
 #else
-    const TCHAR* CommandLine = TEXT("-nohomedir -nosound");
+    const char* MapEnv = getenv("UT2004_MAP");
