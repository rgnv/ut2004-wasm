+// Altered for the web port: the html5.h boolean is deferUntilInEventHandler, not raw input.
+EM_JS(int, Emscripten_RequestRawPointerLock, (void), {
+    const canvas = Module.canvas;
+    if (document.pointerLockElement === canvas) return 1;
+    const fallback = error => {
+        console.warn('SDL: raw pointer lock rejected: ' + error + '; falling back to adjusted movement');
+        try {
+            const request = canvas.requestPointerLock();
+            if (request) request.catch(error => console.warn('SDL: pointer lock failed: ' + error));
+        } catch (error) { console.warn('SDL: pointer lock failed: ' + error); }
+    };
+    console.log('SDL: pointer lock request unadjustedMovement=true (initial/regrab)');
+    try {
+        const request = canvas.requestPointerLock({unadjustedMovement: true});
+        if (request) request.catch(fallback);
+        return 1;
+    } catch (error) { fallback(error); return 1; }
+});
