 #else
     const TCHAR* CommandLine = TEXT("-nohomedir -nosound");
 #endif
@@ -135,6 +138,11 @@ int main(int argc, char** argv)
             Engine->Exec(*FString::Printf(TEXT("open 127.0.0.1?Name=%s"), Name), *GLog);
         }
         GIsRunning = 1;
+        // Only the dedicated 3369 relay opts into the shared admin login.
+        const UBOOL AutoAdmin = EM_ASM_INT({ return Module.connect && Module.relayURL === 'wss://games.rgnv.dev/ut2004b/connect2' ? 1 : 0; });
+        APlayerController* AdminPlayer = NULL;
+        DOUBLE AdminSent = 0;
+        UBOOL AdminReported = 0;
         INT Frame = 0;
         DOUBLE Previous = appSeconds();
         if (Interactive) {
@@ -154,11 +162,28 @@ int main(int argc, char** argv)
             if (Interactive && Engine->Client && Engine->Client->Viewports.Num())
             {
                 APlayerController* Player = Engine->Client->Viewports(0)->Actor;
-                if (!Player) continue;
+                if (!Player || Player->Level->NetMode != NM_Client) {
+                    AdminPlayer = NULL;
+                    if (!Player) continue;
+                }
+                if (AutoAdmin && Player->Level->NetMode == NM_Client && Player->PlayerReplicationInfo) {
+                    if (AdminPlayer != Player) {
+                        AdminPlayer = Player;
+                        AdminSent = Now;
+                        AdminReported = 0;
+                        Engine->Client->Viewports(0)->Exec(TEXT("adminlogin ut2004"), *GLog);
+                    }
+                    if (!AdminReported && (Player->PlayerReplicationInfo->bAdmin || Now - AdminSent > 10.0)) {
+                        debugf(NAME_Log, Player->PlayerReplicationInfo->bAdmin
+                            ? TEXT("WASM: auto-admin granted") : TEXT("WASM: auto-admin not granted; continuing gameplay"));
+                        AdminReported = 1;
+                    }
+                }
                 AActor* Target = Player->Pawn ? (AActor*)Player->Pawn : (AActor*)Player;
-                EM_ASM({ Module.playerState = ({tick: $0, position: [$1,$2,$3], rotation: [$4,$5,$6], pawn: !!$7, netMode: $8}); },
+                EM_ASM({ Module.playerState = ({tick: $0, position: [$1,$2,$3], rotation: [$4,$5,$6], pawn: !!$7, netMode: $8, admin: !!$9}); },
                     Frame, Target->Location.X, Target->Location.Y, Target->Location.Z,
-                    Player->Rotation.Pitch, Player->Rotation.Yaw, Player->Rotation.Roll, Player->Pawn != NULL, Player->Level->NetMode);
+                    Player->Rotation.Pitch, Player->Rotation.Yaw, Player->Rotation.Roll, Player->Pawn != NULL, Player->Level->NetMode,
+                    Player->PlayerReplicationInfo && Player->PlayerReplicationInfo->bAdmin);
             }
         }
         GIsRunning = 0;
